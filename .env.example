HOST=127.0.0.1
PORT=3005

# Only exact hostnames you own / are authorized to load-test.
ALLOWED_TARGET_HOSTS=

# 1 vCPU / 1 GB RAM starting point.
MAX_CONCURRENCY=20
MAX_CAMPAIGN_REQUESTS=100000
MIN_CAMPAIGN_SECONDS=60
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES_PER_SLOT=2
RETRY_BACKOFF_MS=2000
STATE_FILE=./data/campaigns.json

# Enable before exposing the dashboard through nginx/caddy.
AUTH_ENABLED=false
ADMIN_USER=
ADMIN_PASSWORD=
GUEST_USER=
GUEST_PASSWORD=

# Optional completion notifications. Keep the token in environment variables, never source code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
