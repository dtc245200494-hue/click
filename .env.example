# Bind to localhost by default. Put nginx/caddy in front if exposing externally.
HOST=127.0.0.1
PORT=3005

# REQUIRED for non-local targets. Comma-separated exact hostnames you own / are authorized to test.
# Example: ALLOWED_TARGET_HOSTS=staging.example.com,api.staging.example.com
ALLOWED_TARGET_HOSTS=

# Safety limits for a small VPS. MAX_CONCURRENCY is a GLOBAL ceiling across all campaigns.
MAX_CONCURRENCY=20
MAX_CAMPAIGN_REQUESTS=100000
MIN_CAMPAIGN_SECONDS=60
REQUEST_TIMEOUT_MS=15000
